# MindMap AI-Sec environment

# Database. The app uses H2 memory DB by default if DB_URL is empty.
DB_URL=jdbc:h2:mem:mindmap;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DB_DIALECT=org.hibernate.dialect.H2Dialect

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM gateway
LLM_DEFAULT_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k

# Doubao uses Volcengine Ark. DOUBAO_MODEL is usually your Ark endpoint/model id.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEFAULT_CHAT_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_USER_CHAT_PATH=

# Rain Classroom
RAIN_CLASSROOM_COOKIE=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRATION_MS=86400000

# App
APP_ENV=dev
APP_DEBUG=true
APP_PORT=8080
APP_CONTEXT_PATH=/

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs
