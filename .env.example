# ============================================
# MindMap AI-Sec 环境变量配置
# ============================================

# 数据库配置
DB_PASSWORD=your-secure-db-password
DB_USERNAME=root
DB_HOST=db
DB_PORT=3306
DB_NAME=mindmap

# Redis 配置
REDIS_PASSWORD=your-redis-password
REDIS_HOST=redis
REDIS_PORT=6379

# OpenAI API
OPENAI_API_KEY=sk-your-actual-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRATION_MS=86400000

# Keystore 配置（HTTPS）
KEYSTORE_PASSWORD=changeit
KEYSTORE_PATH=/app/keystore.p12

# 应用配置
APP_ENV=dev
APP_DEBUG=true
APP_PORT=8080
APP_CONTEXT_PATH=/

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=/var/log/mindmap

# 文件上传
FILE_UPLOAD_MAX_SIZE=52428800
FILE_UPLOAD_PATH=/uploads
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# RAG 配置
RAG_MODEL=gpt-3.5-turbo
RAG_EMBEDDING_MODEL=text-embedding-ada-002
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600

# 网络测量配置
NETWORK_SPEEDTEST_INTERVAL=3600
NETWORK_RETENTION_DAYS=30

# MFA 配置
MFA_ENABLED=true
MFA_ISSUER=MindMap-AI-Sec
MFA_WINDOW_SIZE=1

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600

# Nginx 配置
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_WORKER_PROCESSES=4
NGINX_WORKER_CONNECTIONS=1024
